# Copy to dsmlp.env and edit the two FILL_IN username placeholders.
# The paths below are locations INSIDE the DSMLP job container.
# The team's existing E-STEER setup documents the /home/USER/private mount.
PROJECT_DIR_ON_DSMLP=/home/FILL_IN_USER/private/pain-axis-reproduction
OFFICIAL_DIR_ON_DSMLP=/home/FILL_IN_USER/private/Pain-axis-official

# Planning values for 7B all-layer extraction, NOT validated allocations.
# "large" was documented as about 48 GB in the group's DSMLP example.
# Check your current quota, available class, memory and runtime limits.
GPU_CLASS=large
CPUS=8
MEM_GB=64
GPUS=1

# Always submit a lightweight check first; switch to extract deliberately.
RUN_MODE=preflight

# Stored on the mounted project path; survive container termination.
VENV_DIR=${PROJECT_DIR_ON_DSMLP}/.venv-dsmlp
HF_HOME_DIR=${PROJECT_DIR_ON_DSMLP}/.hf_cache
RUN_LOG_DIR=${PROJECT_DIR_ON_DSMLP}/run_logs
